<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SupportClue" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/support_clue_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/support_clue_orange</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.SupportClue.Splash" parent="Theme.SupportClue">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
