<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartBusinessDesk" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/sbd_navy</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/sbd_green</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.SmartBusinessDesk.Splash" parent="Theme.SmartBusinessDesk">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
